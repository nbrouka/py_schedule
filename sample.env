# Sample environment configuration
# Copy this to .env and fill in your values
# IMPORTANT: Add .env to .gitignore to avoid committing secrets

# Storage backend: google_drive | nextcloud
STORAGE_TYPE=google_drive

# Google Drive folder ID (for google_drive)
FOLDER_ID=your_google_drive_folder_id_here

# Nextcloud share URL (for nextcloud)
NEXTCLOUD_URL=https://nextcloud.psu.by/index.php/s/no5zKbMrns6j5jQ?dir=/2026-2027/Факультет информационных технологий/Дневная форма/Расписание занятий

# Optional: Nextcloud credentials (if share requires auth)
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=

# Teacher name to search for in schedules
TARGET_TEACHER=Бровко Н.В.
